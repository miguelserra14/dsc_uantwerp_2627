.env
.venv/
venv/

# --- Backups / caches ---
*.bak
.ipynb_checkpoints/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# --- OS / OneDrive / Office lock files ---
Thumbs.db
desktop.ini
.DS_Store
~$*

